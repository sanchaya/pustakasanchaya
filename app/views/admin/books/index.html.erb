<% content_for :page_title do %>
  Books Management
<% end %>

<div class="row mb-4">
  <div class="col-md-12">
    <div class="card">
      <div class="card-body">
        <form method="GET" action="<%= admin_books_path %>" class="mb-0">
          <div class="input-group">
            <input 
              type="text" 
              class="form-control" 
              name="q"
              placeholder="Search books by title, author, or publisher..."
              value="<%= @query %>"
              autofocus>
            <button class="btn btn-primary" type="submit">
              <i class="fas fa-search"></i> Search
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Bulk Actions Toolbar -->
<div class="row mb-3" id="bulkActionsToolbar" style="display: none;">
  <div class="col-md-12">
    <div class="card">
      <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-muted">
          <span id="selectedCount">0</span> book(s) selected
        </span>
        <div class="d-flex gap-2">
          <button class="btn btn-warning" id="bulkMergeBtn" disabled>
            <i class="fas fa-compress-arrows-alt"></i> Merge Selected
          </button>
          <button class="btn btn-secondary" id="clearSelectionBtn">
            <i class="fas fa-times"></i> Clear Selection
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<% if @books.any? %>
  <div class="row">
    <div class="col-md-12">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title" style="color: #5F3792;">
            <i class="fas fa-book"></i> 
            Search Results 
            <span class="badge bg-secondary"><%= @books.total_count %></span>
          </h5>

          <div class="table-responsive">
            <table class="table table-hover">
              <thead style="background: #f5f5f5;">
                <tr>
                  <th style="width: 40px;">
                    <input type="checkbox" id="selectAllBooks" class="form-check-input">
                  </th>
                  <th>Title</th>
                  <th>Author</th>
                  <th>Publisher</th>
                  <th>Year</th>
                  <th>Source</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @books.each do |book| %>
                  <tr>
                    <td>
                      <input type="checkbox" class="form-check-input book-checkbox" value="<%= book['id'] %>" data-title="<%= escape_javascript(truncate(book['name'], length: 50)) %>">
                    </td>
                    <td>
                      <strong><%= truncate(book['name'], length: 40) %></strong>
                    </td>
                    <td>
                      <small><%= truncate(book['author'], length: 30) %></small>
                    </td>
                    <td>
                      <small><%= truncate(book['publisher'], length: 25) %></small>
                    </td>
                    <td>
                      <small><%= book['year'] || 'N/A' %></small>
                    </td>
                    <td>
                      <small>
                        <% if book.stores.any? %>
                          <div class="d-flex gap-1 flex-wrap">
                            <% shown_urls = [] %>
                            <% book.stores.each do |store| %>
                              <% store_link = book.book_stores.find { |bs| bs.store_id == store.id }&.store_url %>
                              <% next if store_link.blank? || shown_urls.include?(store_link) %>
                              <% shown_urls << store_link %>
                              <a href="<%= store_link %>" target="_blank" title="<%= store.name %>" class="text-decoration-none">
                                <% if store.logo.present? %>
                                  <img src="<%= store.logo %>" alt="<%= store.name %>" style="width: 24px; height: 24px; object-fit: contain;">
                                <% else %>
                                  <span class="badge bg-light text-dark" style="font-size: 0.7rem;"><%= truncate(store.name, length: 8) %></span>
                                <% end %>
                              </a>
                            <% end %>
                          </div>
                        <% else %>
                          <span class="badge bg-secondary"><%= book['library'] %></span>
                        <% end %>
                      </small>
                    </td>
                    <td>
                      <button 
                        class="btn btn-sm btn-outline-primary edit-book-btn"
                        data-book-id="<%= book['id'] %>"
                        title="Edit metadata">
                        <i class="fas fa-edit"></i> Edit
                      </button>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <nav class="mt-4">
            <%= paginate @books %>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Modal -->
  <div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header" style="background: #5F3792; color: white;">
          <h5 class="modal-title">Edit Book Metadata</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="editModalBody">
          <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" onclick="saveBookEdit()">
            <i class="fas fa-save"></i> Save Changes
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bulk Merge Modal -->
  <div class="modal fade" id="bulkMergeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header" style="background: #5F3792; color: white;">
          <h5 class="modal-title"><i class="fas fa-compress-arrows-alt"></i> Merge Selected Books</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Warning:</strong> This will permanently merge selected books into a single target book.
            The source books will be deleted. This action cannot be undone.
          </div>
          
          <h6>Selected Books to Merge (<span id="mergeSelectedCount">0</span>):</h6>
          <div id="selectedBooksList" class="mb-3" style="max-height: 200px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; background: #f8f9fa;">
            <!-- populated dynamically -->
          </div>

          <hr>

          <h6>Target Book (will keep this one):</h6>
          <div class="mb-3">
            <label class="form-label">Select target book *</label>
            <select class="form-select" id="targetBookSelect" required>
              <option value="">Choose a book to keep...</option>
              <% @books.each do |book| %>
                <option value="<%= book['id'] %>" data-title="<%= escape_javascript(truncate(book['name'], length: 60)) %>">
                  <%= truncate(book['name'], length: 60) %> (<%= book['author'] %>, <%= book['year'] || 'N/A' %>)
                </option>
              <% end %>
            </select>
            <div class="form-text">Select which book will be the merged target. Other selected books will be merged into this one.</div>
          </div>

          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="includeCurrentPageOnly" checked>
            <label class="form-check-label" for="includeCurrentPageOnly">
              Only merge books from current search results page
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-danger" onclick="performBulkMerge()" id="confirmMergeBtn">
            <i class="fas fa-compress-arrows-alt"></i> Merge Books
          </button>
        </div>
      </div>
    </div>
  </div>
<% elsif @query.present? %>
  <div class="alert alert-info">
    <i class="fas fa-search"></i> No books found matching "<strong><%= @query %></strong>". Try a different search.
  </div>
<% end %>

<%= javascript_include_tag "admin_books", "data-turbolinks-track" => "reload" %>