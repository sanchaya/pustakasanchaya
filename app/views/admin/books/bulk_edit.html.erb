<% content_for :page_title do %>
  Bulk Edit Books
<% end %>

<div class="row">
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title" style="color: #5F3792;">
          <i class="fas fa-search-plus"></i> Find & Replace
        </h5>

        <form id="bulkEditForm">
          <div class="mb-3">
            <label for="field" class="form-label">Field to Edit</label>
            <select class="form-select" id="field" name="field" required>
              <option value="">-- Select Field --</option>
              <option value="name">Book Title</option>
              <option value="author">Author</option>
              <option value="publisher">Publisher</option>
              <option value="year">Year</option>
              <option value="library">Library</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="findValue" class="form-label">Find Value</label>
            <input 
              type="text" 
              class="form-control" 
              id="findValue" 
              name="find_value"
              placeholder="Value to find"
              required>
          </div>

          <div class="mb-3">
            <label for="replaceValue" class="form-label">Replace With</label>
            <input 
              type="text" 
              class="form-control" 
              id="replaceValue" 
              name="replace_value"
              placeholder="Replacement value"
              required>
          </div>

          <div class="mb-3">
            <label for="scope" class="form-label">Match Type</label>
            <select class="form-select" id="scope" name="scope">
              <option value="contains">Contains (Partial Match)</option>
              <option value="exact">Exact Match</option>
              <option value="starts_with">Starts With</option>
              <option value="ends_with">Ends With</option>
            </select>
            <small class="text-muted">
              <br><i class="fas fa-info-circle"></i> 
              <strong>Contains:</strong> "Smith" matches "John Smith"<br>
              <strong>Exact:</strong> Must match entire value<br>
              <strong>Starts With:</strong> "The" matches "The Great Gatsby"<br>
              <strong>Ends With:</strong> "Inc." matches "Penguin Inc."
            </small>
          </div>

          <button type="button" class="btn btn-info w-100 mb-2" onclick="previewChanges()">
            <i class="fas fa-eye"></i> Preview Changes
          </button>
          <button type="button" class="btn btn-warning w-100" onclick="showWarning()">
            <i class="fas fa-exclamation-triangle"></i> Apply Changes
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-8">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title" style="color: #5F3792;">
          <i class="fas fa-list"></i> Preview Results
        </h5>
        
        <div id="previewContainer" style="min-height: 400px;">
          <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Click "Preview Changes" to see which books will be affected
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script data-cfasync="false">
  window.adminBulkEditPaths = {
    preview: '<%= admin_bulk_preview_books_path %>',
    apply: '<%= admin_bulk_update_books_path %>',
    back: '<%= admin_books_path %>'
  };
</script>

<%= javascript_include_tag "admin_bulk_edit", "data-turbolinks-track" => "reload" %>
